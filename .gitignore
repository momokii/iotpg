# Secrets — never commit real values
.env
.env.staging
.env.production
.env.local
!.env.example

# Dependencies (uncomment for your stack once known)
# node_modules/
# vendor/
# __pycache__/
# .venv/

# Build output
# dist/
# build/
# out/

# ESP-IDF firmware artifacts (per project under firmware/)
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/managed_components/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Machine-local tooling (indexes, session state — never shared)
# Note: .codegraph is a symlink, so it needs the bare pattern (no slash).
.codegraph
.omo/
